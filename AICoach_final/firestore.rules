rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsInterview(interviewId) {
      return signedIn()
        && get(/databases/$(database)/documents/interviews/$(interviewId)).data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow create, read, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /interviews/{interviewId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;

      match /questions/{questionId} {
        allow read, write: if ownsInterview(interviewId);
      }
    }
  }
}
