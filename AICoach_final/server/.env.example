NODE_ENV=development
PORT=5000

# Comma-separated origins allowed to call the API
CLIENT_ORIGIN=http://localhost:5173

# Optional. Set this only if the API runs behind a reverse proxy/load balancer
# (Render, Railway, Heroku, Nginx, etc.), so rate limiting sees the real client IP
# instead of the proxy's. Common values: "1" (trust the first hop) or a specific IP/CIDR.
# Leave unset for local development.
# TRUST_PROXY=1

# Firebase Admin SDK credentials
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your_service_account_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_me\n-----END PRIVATE KEY-----\n"

# Groq configuration. Never expose this value to the client.
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
