# Firebase web app configuration. These values identify your Firebase project to the
# browser and are safe to ship in a client bundle - they are not secrets. Actual data
# access is protected by Firestore Security Rules (see /firestore.rules), not by keeping
# these values hidden.
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Express API base URL
VITE_API_BASE_URL=http://localhost:5000/api
